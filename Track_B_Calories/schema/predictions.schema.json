{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "predictions.json — A's actual format (Track_A_Detection/emit_predictions.py)",
  "type": "object",
  "required": ["classes", "predictions"],
  "properties": {
    "schema_version": { "type": "integer" },
    "generated": { "type": "string" },
    "model": { "type": "string" },
    "run": { "type": "string" },
    "conf_threshold": { "type": "number" },
    "iou_threshold": { "type": "number" },
    "classes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Index order matches class_id (17 classes)"
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["image_id", "image_size", "boxes"],
        "properties": {
          "image_id": { "type": "string", "description": "image filename" },
          "image_size": {
            "type": "array", "items": { "type": "integer" },
            "minItems": 2, "maxItems": 2, "description": "[width, height]"
          },
          "boxes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["class", "class_id", "conf", "xyxy"],
              "properties": {
                "class": { "type": "string" },
                "class_id": { "type": "integer" },
                "conf": { "type": "number" },
                "xyxy": {
                  "type": "array", "items": { "type": "number" },
                  "minItems": 4, "maxItems": 4,
                  "description": "[x1,y1,x2,y2] absolute px in original image resolution"
                }
              }
            }
          }
        }
      }
    }
  }
}
